# Copy to .env in the repo root for the Python API.
# Copy the NEXT_PUBLIC_* and web-only values to web/.env.local as well.

# --- Next.js (safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Next.js server only (web/.env.local) ---
# Never prefix with NEXT_PUBLIC. Used only in server code if you add admin jobs later.
SUPABASE_SERVICE_ROLE_KEY=

# --- Python API ---
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SUPABASE_URL=
# Same anon key as NEXT_PUBLIC_SUPABASE_ANON_KEY. Used by the Python API with the user JWT so PostgREST RLS loads owned brand/pillar rows. Not the service role.
SUPABASE_ANON_KEY=
# Optional. Only needed for legacy HS256 JWTs. New Supabase projects sign access tokens with ES256; the API loads public keys from SUPABASE_URL JWKS.
SUPABASE_JWT_SECRET=

# Legacy Flask/Mongo/publish placeholders are intentionally omitted.
# Do not put LinkedIn, Instagram, Pexels, or Mongo credentials in the studio path.
